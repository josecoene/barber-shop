# Valores da homologação. Copie para envs/homolog.tfvars (o Git ignora) e use no plan:
#   terraform plan "-var-file=envs/homolog.tfvars"
# Sem senha nem segredo aqui: o que for sensível vem do SSM ou de variável de ambiente.

environment = "homolog"
region      = "us-east-1"
vpc_cidr    = "10.20.0.0/16"
az_count    = 2

# Banco (RDS): numa zona só e sem proteção contra exclusão, para economizar e para o
# terraform destroy apagar o ambiente depois da apresentação (fica o snapshot final).
db_deletion_protection = false
db_multi_az            = false

# Cache (ElastiCache Valkey): um nó só, sem réplica e sem failover.
cache_node_type          = "cache.t4g.micro"
cache_num_cache_clusters = 1
cache_automatic_failover = false

# Imagens com tag guardadas em cada repositório do ECR e dias de log no CloudWatch.
ecr_keep_tagged_images = 10
log_retention_days     = 30

# Sem domínio: deixe vazio, e a feat/infra-computacao usa o DNS do ALB no APP_URL.
app_url = ""

# E-mail: smtp com o provedor do grupo. Preencha o servidor (mail_host) e a porta
# (mail_port) do provedor; com mail_host vazio, o parâmetro MAIL_HOST não é criado e o
# e-mail não sai. Usuário e senha (MAIL_USERNAME e MAIL_PASSWORD) entram à mão no SSM, veja
# docs/nuvem/TERRAFORM.md. Troque o remetente por um endereço do domínio verificado no provedor.
mail_mailer       = "smtp"
mail_host         = ""
mail_port         = 587
mail_from_address = "nao-responda@example.com"
