# Valores da produção. Copie para envs/prod.tfvars (o Git ignora) e use no plan:
#   terraform plan "-var-file=envs/prod.tfvars"
# Sem senha nem segredo aqui: o que for sensível vem do SSM ou de variável de ambiente.

environment = "prod"
region      = "us-east-1"

# Faixa diferente da homolog, para as duas VPCs poderem se conectar um dia sem conflito de IP.
vpc_cidr = "10.30.0.0/16"
az_count = 2

# Banco (RDS): réplica de espera em outra zona (Multi-AZ) e proteção contra exclusão.
# Para destruir a prod, mude db_deletion_protection para false e aplique antes do destroy.
db_deletion_protection = true
db_multi_az            = true

# Cache (ElastiCache Valkey): primário e uma réplica em outra zona, com failover automático.
cache_node_type          = "cache.t4g.micro"
cache_num_cache_clusters = 2
cache_automatic_failover = true

# Imagens com tag guardadas em cada repositório do ECR e dias de log no CloudWatch.
ecr_keep_tagged_images = 10
log_retention_days     = 30

# Sem domínio: deixe os dois vazios, e o APP_URL fica com o DNS do ALB, em HTTP. Com domínio e
# certificado do ACM (mesma região), os dois juntos, ex.:
#   app_url         = "https://barberflow.com.br"
#   certificate_arn = "arn:aws:acm:us-east-1:<conta>:certificate/<id>"
app_url         = ""
certificate_arn = ""

# E-mail: smtp com o provedor do grupo. Preencha o servidor (mail_host) e a porta
# (mail_port) do provedor; com mail_host vazio, o parâmetro MAIL_HOST não é criado e o
# e-mail não sai. Usuário e senha (MAIL_USERNAME e MAIL_PASSWORD) entram à mão no SSM, veja
# docs/nuvem/TERRAFORM.md. Troque o remetente por um endereço do domínio verificado no provedor.
mail_mailer       = "smtp"
mail_host         = ""
mail_port         = 587
mail_from_address = "nao-responda@example.com"

# ALB com proteção contra exclusão. Para destruir a prod, mude para false e aplique antes do destroy.
alb_deletion_protection = true

# Instâncias do app (Auto Scaling): t3.micro com disco de 30 GB, mínimo 1, desejado 2 (uma em
# cada zona) e máximo 4, escalando pela CPU média. No primeiro apply, antes de existir imagem
# no ECR, use mínimo e desejado 0 (docs/nuvem/TERRAFORM.md, "Primeiro deploy").
instance_type        = "t3.micro"
root_volume_size     = 30
asg_min_size         = 1
asg_desired_capacity = 2
asg_max_size         = 4
asg_cpu_target       = 60

# Orçamento mensal da conta inteira (US$ 30), com aviso por e-mail a 80% do gasto real e a 100%
# do previsto. Preencha com o e-mail do grupo; vazio, o orçamento não é criado.
budget_limit_usd   = 30
budget_alert_email = ""

# Deploy pelo GitHub Actions (cicd.tf e docs/nuvem/CI-CD.md). A prod cria a role de deploy e o
# provedor OIDC do GitHub, que é um por conta. Antes do apply que cria a role, configure no
# GitHub o environment production com revisores obrigatórios e só a branch main e as tags v*
# (CI-CD.md, "Primeiro deploy"): sem essas proteções, um workflow de qualquer branch assumiria a
# role. Se o GitHub não oferecer as proteções (repositório privado sem o plano que as libera),
# use create_deploy_role = false e publique à mão (TERRAFORM.md, "Primeiro deploy").
# Os IDs do dono e do repositório entram no formato imutável do sub, o dos repositórios criados
# depois de 15/07/2026. O primeiro commit do repositório é de 24/09/2026, então preencha os dois
# antes do primeiro deploy: sem eles, o deploy para no passo do OIDC com "Not authorized to
# perform sts:AssumeRoleWithWebIdentity". Pegue os dois com:
#   gh api repos/josecoene/barber-shop --jq '.owner.id, .id'
create_deploy_role          = true
create_github_oidc_provider = true
github_repository           = "josecoene/barber-shop"
github_environment          = "production"
github_repository_owner_id  = ""
github_repository_id        = ""
