APP_NAME=BarberFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço público do app. Fora do local, os links dos e-mails e os redirecionamentos sempre começam por ele
APP_URL=http://localhost:8000
# Fuso da aplicação: o now() do PHP, a agenda ("hoje" e "agora"), o dashboard e as datas gravadas no banco
APP_TIMEZONE=America/Sao_Paulo

# Idioma das mensagens da API e das telas (lang/pt_BR). O inglês fica só como reserva
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
# Idioma dos dados falsos do Faker. Só a UserFactory padrão do Laravel usa, e nenhum seeder nem teste chama ela
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberflow
DB_USERNAME=root
DB_PASSWORD=
# Segundos para desistir de abrir a conexão com o MySQL. Com o banco fora do ar, o erro sai logo. O Laravel
# tenta de novo quando a conexão cai: com 3, o /api/health respondeu 503 em 12 s num banco inalcançável
DB_CONNECT_TIMEOUT=3
# Segundos que cada leitura do MySQL espera a resposta, só nas requisições web (o mysqlnd.net_read_timeout do PHP).
# Com o banco de pé e sem responder, o pedido desiste em até 4 vezes este valor (o Laravel tenta de novo), antes dos
# 60 s do Nginx: com 5, o /api/health respondeu 503 em 20 s com o banco congelado. Vazio ou 0 vale o padrão (5).
# Migrations, agendador e seeders, na linha de comando, ficam sem esse limite
DB_READ_TIMEOUT=5
# Certificado de CA para conectar no MySQL por TLS. Na AWS, o bundle do RDS que a imagem traz
# (/etc/ssl/certs/rds-global-bundle.pem), porque o RDS só aceita TLS. Vazio no local
MYSQL_ATTR_SSL_CA=
# Só nos containers de produção (docker/php/entrypoint.sh): true roda as migrations quando o app sobe.
# O php artisan serve e o docker-compose.yml de desenvolvimento não usam
RUN_MIGRATIONS=false

# Sessão das telas no banco (tabela sessions). Na homolog e na AWS, o docker-compose.prod.yml troca para redis,
# porque as instâncias dividem as sessões e as travas do agendador
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão só por HTTPS. Ligue (true) em produção, atrás do HTTPS do ALB.
SESSION_SECURE_COOKIE=

# Validade, em minutos, do token Bearer do POST /api/login. O sanctum:prune-expired apaga os vencidos todo dia
SANCTUM_EXPIRATION=480
# Prefixo do token da API. Ajuda as ferramentas de varredura de segredos a achar um token vazado
SANCTUM_TOKEN_PREFIX=barberflow_
# Hosts das telas que chamam a API com o cookie da sessão. Sem a variável, vale localhost e o host do APP_URL
# SANCTUM_STATEFUL_DOMAINS=localhost:8000

# Requisições por minuto em toda a API, por usuário logado ou, sem login, por IP (a homolog de carga sobe este valor)
API_RATE_LIMIT=120
# Senhas erradas por minuto no login, por e-mail + IP (telas e API). Passou, 429 com Retry-After
LOGIN_RATE_LIMIT=5
# Tentativas de login por minuto por IP, com qualquer e-mail: barra quem testa muitas contas de uma vez
LOGIN_IP_RATE_LIMIT=20

# Administrador inicial (php artisan db:seed --class=AdminUserSeeder). Sem e-mail ou senha, o seeder só avisa.
# Nome do administrador. Vazio: "Administrador"
ADMIN_NAME=
# E-mail do administrador, que vira o login dele
ADMIN_EMAIL=
# Senha do administrador, de no mínimo 8 caracteres (a regra das outras senhas do sistema; com menos, o seeder
# avisa e não cria nada). Defina só no ambiente do comando e apague depois
ADMIN_PASSWORD=

# Proxies confiáveis, separados por vírgula (ex.: a faixa da VPC do ALB). Vazio: nenhum.
# Atrás do ALB, sem isso todo visitante parece vir do IP do ALB e divide o mesmo limite de requisições,
# e, com APP_URL em https, o link de confirmação de e-mail não vale (o app não sabe que veio por https)
TRUSTED_PROXIES=
# Hosts aceitos além do host do APP_URL e dos IPs privados, separados por vírgula
TRUSTED_HOSTS=
# Content-Security-Policy (true ou false). Vazio: ligada só com APP_ENV=production
SECURITY_CSP=
# Origens que chamam a API pelo navegador, separadas por vírgula. Vazio: o APP_URL
CORS_ALLOWED_ORIGINS=
# Horas mínimas antes do horário para o cliente cancelar o próprio agendamento
CLIENT_CANCEL_MIN_HOURS=2
# Agendamentos ativos de hoje em diante que o cliente pode ter ao agendar pela conta dele (a barbearia não tem limite)
CLIENT_MAX_ACTIVE_APPOINTMENTS=3
# Até quantos dias depois de hoje dá para agendar ou remarcar
BOOKING_DAYS_AHEAD=60
# Expediente da agenda. Abertura do dia, em HH:MM
BUSINESS_OPENING=09:00
# Fechamento do dia, em HH:MM. O atendimento começa e termina dentro do expediente
BUSINESS_CLOSING=19:00
# Fatia dos horários, em minutos: os horários começam de fatia em fatia a partir da abertura (09:00, 09:30...)
BUSINESS_SLOT_MINUTES=30
# Dias de atendimento no padrão ISO (1 é segunda e 7 é domingo), separados por vírgula
BUSINESS_DAYS=1,2,3,4,5,6
# Fidelidade: a cada quantas visitas (atendimentos concluídos) o cliente ganha um prêmio
LOYALTY_VISITS=10
# Fidelidade: o desconto do prêmio, de 0 a 100 (100 é o atendimento grátis)
LOYALTY_DISCOUNT_PERCENT=100
# Lembrete por e-mail dos agendamentos que começam nas próximas horas (comando appointments:send-reminders)
REMINDER_HOURS_BEFORE=24
# Nome da barbearia no lembrete por e-mail. Vazio: vale o APP_NAME
BARBERSHOP_NAME=
# Endereço da barbearia no lembrete por e-mail. Vazio: a linha fica de fora
BARBERSHOP_ADDRESS=
# Telefone da barbearia no lembrete por e-mail. Vazio: a linha fica de fora
BARBERSHOP_PHONE=
# Seed de demonstração da homologação (php artisan db:seed --class=DemoSeeder --force): só roda com
# DEMO_SEED_ENABLED=true. O docker-compose.homolog.yml liga; no local e na AWS fica desligado
DEMO_SEED_ENABLED=false
# Senha dos logins de demonstração (3 barbeiros e 4 clientes com conta), de no mínimo 8 caracteres. Defina só
# no ambiente do comando do DemoSeeder, nunca num arquivo versionado como este. Vazia: o seeder não cria nada
DEMO_USER_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Cache no banco (tabela cache). Na homolog e na AWS, o docker-compose.prod.yml troca para redis
CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
# Segundos para desistir de abrir a conexão com o Redis. Com o cache fora do ar, o erro sai logo
REDIS_CONNECT_TIMEOUT=3
# Segundos para desistir de esperar cada resposta do Redis. Com o cache congelado, o erro sai logo
REDIS_READ_TIMEOUT=3

# log só serve no local: em vez de enviar, grava cada e-mail inteiro no storage/logs/laravel.log, com o endereço
# de quem recebe e os dados do horário (confirmação de conta, esqueci a senha e lembrete). Fora do local, use smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
