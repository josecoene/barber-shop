APP_NAME=BarberFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Endereço público do app. Fora do local, os links dos e-mails e os redirecionamentos sempre começam por ele
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barberflow
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Cookie de sessão só por HTTPS. Ligue (true) em produção, atrás do HTTPS do ALB.
SESSION_SECURE_COOKIE=

# Token da API (POST /api/login): validade em minutos e prefixo do token
SANCTUM_EXPIRATION=480
SANCTUM_TOKEN_PREFIX=barberflow_
# Hosts das telas que chamam a API com o cookie da sessão. Sem a variável, vale localhost e o host do APP_URL
# SANCTUM_STATEFUL_DOMAINS=localhost:8000

# Limites por minuto: toda a API (por usuário ou IP), senhas erradas por e-mail + IP e tentativas de login por IP
API_RATE_LIMIT=120
LOGIN_RATE_LIMIT=5
LOGIN_IP_RATE_LIMIT=20

# Administrador inicial (php artisan db:seed --class=AdminUserSeeder). Sem e-mail ou senha, o seeder só avisa
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Proxies confiáveis, separados por vírgula (ex.: a faixa da VPC do ALB). Vazio: nenhum.
# Atrás do ALB, sem isso todo visitante parece vir do IP do ALB e divide o mesmo limite de requisições,
# e, com APP_URL em https, o link de confirmação de e-mail não vale (o app não sabe que veio por https)
TRUSTED_PROXIES=
# Hosts aceitos além do host do APP_URL e dos IPs privados, separados por vírgula
TRUSTED_HOSTS=
# Content-Security-Policy (true ou false). Vazio: ligada só com APP_ENV=production
SECURITY_CSP=
# Origens que chamam a API pelo navegador, separadas por vírgula. Vazio: o APP_URL
CORS_ALLOWED_ORIGINS=
# Horas mínimas antes do horário para o cliente cancelar o próprio agendamento
CLIENT_CANCEL_MIN_HOURS=2
# Agendamentos ativos de hoje em diante que o cliente pode ter ao agendar pela conta dele (a barbearia não tem limite)
CLIENT_MAX_ACTIVE_APPOINTMENTS=3
# Até quantos dias depois de hoje dá para agendar ou remarcar
BOOKING_DAYS_AHEAD=60
# Expediente da agenda: abertura e fechamento (HH:MM), fatia dos horários em minutos
# e dias de atendimento no padrão ISO (1 é segunda e 7 é domingo), separados por vírgula
BUSINESS_OPENING=09:00
BUSINESS_CLOSING=19:00
BUSINESS_SLOT_MINUTES=30
BUSINESS_DAYS=1,2,3,4,5,6
# Fidelidade: a cada quantas visitas (atendimentos concluídos) o cliente ganha um prêmio
# e o desconto do prêmio, de 0 a 100 (100 é o atendimento grátis)
LOYALTY_VISITS=10
LOYALTY_DISCOUNT_PERCENT=100
# Lembrete por e-mail dos agendamentos que começam nas próximas horas (comando appointments:send-reminders)
REMINDER_HOURS_BEFORE=24
# Dados da barbearia no lembrete por e-mail. Sem nome, vale o APP_NAME; endereço e telefone vazios ficam de fora
BARBERSHOP_NAME=
BARBERSHOP_ADDRESS=
BARBERSHOP_PHONE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log só serve no local: em vez de enviar, grava cada e-mail inteiro no storage/logs/laravel.log, com o endereço
# de quem recebe e os dados do horário (confirmação de conta, esqueci a senha e lembrete). Fora do local, use smtp
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
