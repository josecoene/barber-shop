# Modelo do docker/homolog/homolog.env, o arquivo com a chave e as senhas da homolog local.
# Não copie este modelo à mão: o comando do docs/nuvem/DOCKER.md ("Subir") gera o homolog.env
# com valores aleatórios, uma vez só, e se recusa a sobrescrever um que já existe. O Git ignora
# o homolog.env (docker/homolog/.gitignore), e o build das imagens também (.dockerignore).
#
# Os compose leem este arquivo pelo --env-file das funções homolog e homologmon do DOCKER.md.
# Guarde o arquivo enquanto o banco da homolog existir: o MySQL grava as senhas do app e do
# exporter só na primeira subida, quando cria o banco.

# Chave do Laravel (base64: e 32 bytes, como a do php artisan key:generate --show).
HOMOLOG_APP_KEY=

# Senha do usuário barberflow do MySQL, que o app usa.
HOMOLOG_DB_PASSWORD=

# Senha do usuário exporter do MySQL, só de leitura, que o mysqld-exporter do monitoramento usa
# (docker/mysql/init/01-exporter-user.sh).
HOMOLOG_DB_EXPORTER_PASSWORD=

# Senha do admin do Grafana do monitoramento (docker-compose.monitoring.yml).
HOMOLOG_GRAFANA_ADMIN_PASSWORD=
