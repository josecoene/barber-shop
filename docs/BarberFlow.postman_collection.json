{
  "info": {
    "name": "BarberFlow API",
    "description": "Coleção de requisições da API do BarberFlow. Defina a variável baseUrl (padrão http://localhost:8000/api). As listagens são paginadas: page e per_page vêm ligados, e search e status de exemplo vêm desligados na aba Params.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Saúde da aplicação",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "200 com {\"status\":\"ok\"} quando banco e cache respondem; 503 com o que falhou (\"falhou\") quando não. Fica fora do limite de requisições da API."
          }
        }
      ]
    },
    {
      "name": "Services",
      "item": [
        {
          "name": "Listar services",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services?page=1&per_page=15",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Número da página, de 1 a 100000 (padrão 1)."
                },
                {
                  "key": "per_page",
                  "value": "15",
                  "description": "Itens por página, de 1 a 100 (padrão 15)."
                },
                {
                  "key": "search",
                  "value": "corte",
                  "description": "Procura no nome (até 100 caracteres).",
                  "disabled": true
                },
                {
                  "key": "status",
                  "value": "active",
                  "description": "active ou inactive.",
                  "disabled": true
                }
              ]
            },
            "description": "Lista paginada em ordem de nome. Os itens vêm em data; meta traz current_page, last_page, per_page e total, e links traz first, last, prev e next."
          }
        },
        {
          "name": "Criar (services)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Corte de cabelo\",\n  \"duration\": 30,\n  \"price\": 40.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "status é opcional: sem ele, o serviço nasce active. duration de 5 a 480 minutos e price de 0 a 999999.99."
          }
        },
        {
          "name": "Mostrar (services)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "1"
              ]
            }
          }
        },
        {
          "name": "Atualizar parcialmente (services)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "1"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"price\": 45.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Remover (services)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/services/1",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "services",
                "1"
              ]
            },
            "description": "Exclusão lógica: o serviço sai das listas, mas a linha continua no banco."
          }
        }
      ]
    },
